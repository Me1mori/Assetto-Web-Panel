# Copia este archivo como `.env` y ajústalo. `.env` está en `.gitignore`.
# Ninguna de estas variables contiene secretos: el panel no tiene usuarios,
# contraseñas ni tokens, y se supone que va detrás de un proxy inverso.
# Encender y apagar el servidor no pide acceso; lo único que se comprueba es el
# `Origin` de los POST (CSRF), configurado más abajo.

# ── Servidor ───────────────────────────────────────────────────────────────
# Interfaz y puerto del backend. En producción déjalo en 127.0.0.1: el panel
# debe quedar detrás de un proxy inverso (túnel, nginx, Caddy…).
ASSETO_HOST=127.0.0.1
ASSETO_PORT=9094

# Solo desarrollo (dev.py). Usa 0.0.0.0 para probar desde otro dispositivo.
ASSETO_DEV_HOST=127.0.0.1
ASSETO_DEV_PORT=9094

# ── Servidor de juego ──────────────────────────────────────────────────────
# Carpeta principal del servidor dedicado. De aquí se derivan:
#   - logs/  → registros del servidor
#   - cfg/   → archivos de configuración (server_cfg.ini)
#   - tracks/ → pistas (opcional)
ASSETOSERVER_FOLDER=/ruta/al/servidor

# Nombre de la unidad systemd a controlar.
ASSETOSERVER_SERVICE_NAME=assettoserver

# Segundos máximos por comando systemctl.
ASSETOSERVER_COMMAND_TIMEOUT=20

# Tope de líneas que devuelve /api/server/logs.
ASSETOSERVER_MAX_LOG_LINES=500

# Ruta alternativa del archivo .env (por defecto, `.env` en la raíz).
# ASSETO_ENV_FILE=.env

# ── Seguridad HTTP ─────────────────────────────────────────────────────────
# Cabeceras Host permitidas (separadas por comas). Vacío = sin restricción.
# Ejemplo: ASSETO_ALLOWED_HOSTS=panel.ejemplo.com,localhost,127.0.0.1
ASSETO_ALLOWED_HOSTS=

# Orígenes permitidos para los POST de control, además del propio (CSRF).
# Es lo único que frena a otra web; no hay usuarios ni contraseñas.
ASSETO_ALLOWED_ORIGINS=

# ── Frontend (solo desarrollo) ─────────────────────────────────────────────
# Backend al que Astro reenvía /api durante `npm run dev`.
ASTRO_API_TARGET=http://localhost:9094