---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---

<BaseLayout
    title="Menú"
    description="Menú del servidor dedicado de Assetto Corsa."
    current="menu"
>
    <div class="page-head">
        <h1 class="page-title">Menú</h1>
        <p class="page-subtitle">
            Accesos directos del servidor dedicado de Assetto Corsa.
        </p>
    </div>
    <PlaceholderSection
        icon="map"
        title="Próximamente"
        message="Los accesos directos del servidor estarán disponibles aquí."
    />
</BaseLayout>
