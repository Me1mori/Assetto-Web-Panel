---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---

<BaseLayout
    title="Configuración"
    description="Ajustes del servidor dedicado de Assetto Corsa."
    current="config"
>
    <div class="page-head">
        <h1 class="page-title">Configuración</h1>
        <p class="page-subtitle">
            Ajustes del servidor dedicado de Assetto Corsa.
        </p>
    </div>
    <PlaceholderSection
        icon="gear"
        title="Próximamente"
        message="La edición de la configuración del servidor estará disponible aquí."
    />
</BaseLayout>
