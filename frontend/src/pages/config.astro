---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
    title="Configuración"
    description="Sesiones, pista dinámica y cupo del servidor dedicado de Assetto Corsa."
    current="config"
>
    <div class="page-head">
        <h1 class="page-title">Configuración</h1>
    </div>

    <p class="logs-state" id="config-state" role="status">
        Cargando configuración…
    </p>

    <form class="stack" id="config-form" hidden>
        <div class="content-grid config-grid" id="config-grid" aria-busy="true">
            <section class="card config-card" aria-labelledby="cfg-servidor">
                <div class="config-header">
                    <Icon name="gear" size={20} />
                    <h2 id="cfg-servidor">Servidor</h2>
                </div>
                <div class="config-body">
                    <div class="config-item">
                        <span class="config-label">Nombre</span>
                        <span class="config-value" id="servidor-nombre">…</span>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Cupo</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                max="128"
                                data-section="SERVER"
                                data-key="MAX_CLIENTS"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Nivel IA</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="SERVER"
                                data-key="AI_LEVEL"
                            />
                        </label>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Contraseña</span>
                        <span class="config-value" id="servidor-pass">…</span>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Contraseña admin</span>
                        <span class="config-value" id="servidor-admin">…</span>
                    </div>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-sesiones">
                <div class="config-header">
                    <Icon name="gauge" size={20} />
                    <h2 id="cfg-sesiones">Sesiones</h2>
                </div>
                <div class="config-body">
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Práctica</span>
                            <input
                                class="field-input"
                                type="text"
                                data-section="PRACTICE"
                                data-key="NAME"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Minutos</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                data-section="PRACTICE"
                                data-key="TIME"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Práctica abierta</span>
                            <select
                                class="field-input"
                                data-section="PRACTICE"
                                data-key="IS_OPEN"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Práctica infinita</span>
                            <select
                                class="field-input"
                                data-section="PRACTICE"
                                data-key="INFINITE"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Carrera</span>
                            <input
                                class="field-input"
                                type="text"
                                data-section="RACE"
                                data-key="NAME"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Vueltas</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                data-section="RACE"
                                data-key="LAPS"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Espera (s)</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="RACE"
                                data-key="WAIT_TIME"
                            />
                        </label>
                    </div>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-pista">
                <div class="config-header">
                    <Icon name="map" size={20} />
                    <h2 id="cfg-pista">Pista dinámica</h2>
                </div>
                <div class="config-body">
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Agarre inicial %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="SESSION_START"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Aleatoriedad %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="RANDOMNESS"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Transferencia %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="SESSION_TRANSFER"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Grip por vuelta</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="DYNAMIC_TRACK"
                                data-key="LAP_GAIN"
                            />
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <p class="alert" id="config-alert" role="alert" hidden></p>
    </form>
</BaseLayout>

<script src="../scripts/config.js"></script>
