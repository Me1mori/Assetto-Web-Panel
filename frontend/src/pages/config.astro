---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
    title="Configuración"
    description="Hora, clima y ajustes del servidor dedicado de Assetto Corsa."
    current="config"
>
    <div class="page-head">
        <h1 class="page-title">Configuración</h1>
    </div>

    <p class="logs-state" id="config-state" role="status">
        Cargando configuración…
    </p>

    <form class="stack" id="config-form" hidden>
        <div class="content-grid config-grid" id="config-grid" aria-busy="true">
            <section class="card config-card" aria-labelledby="cfg-hora">
                <div class="config-header">
                    <Icon name="sun" size={20} />
                    <h2 id="cfg-hora">Hora del día</h2>
                </div>
                <div class="config-body">
                    <label class="field">
                        <span class="field-label">Hora (24 h)</span>
                        <input
                            class="field-input"
                            type="time"
                            id="hora-input"
                        />
                    </label>
                    <div class="config-item">
                        <span class="config-label">SUN_ANGLE resultante</span>
                        <span class="config-value mono" id="hora-sol-valor">…</span>
                    </div>
                    <label class="field">
                        <span class="field-label">Multiplicador de tiempo</span>
                        <input
                            class="field-input"
                            type="number"
                            step="0.1"
                            min="0"
                            data-section="SERVER"
                            data-key="TIME_OF_DAY_MULT"
                        />
                    </label>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-clima">
                <div class="config-header">
                    <Icon name="sun" size={20} />
                    <h2 id="cfg-clima">Clima</h2>
                </div>
                <div class="config-body">
                    <div class="stack" id="weather-cards" aria-busy="true"></div>
                    <button
                        class="btn btn-ghost"
                        id="weather-add"
                        type="button"
                    >
                        Agregar tramo
                    </button>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-servidor">
                <div class="config-header">
                    <Icon name="gear" size={20} />
                    <h2 id="cfg-servidor">Servidor</h2>
                </div>
                <div class="config-body">
                <div class="config-item">
                    <span class="config-label">Nombre</span>
                    <span class="config-value" id="servidor-nombre">…</span>
                </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Pista</span>
                            <input
                                class="field-input mono"
                                type="text"
                                data-section="SERVER"
                                data-key="TRACK"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Variante</span>
                            <input
                                class="field-input mono"
                                type="text"
                                data-section="SERVER"
                                data-key="CONFIG_TRACK"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Neum. legales</span>
                            <input
                                class="field-input mono"
                                type="text"
                                data-section="SERVER"
                                data-key="LEGAL_TYRES"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Cupo</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                max="128"
                                data-section="SERVER"
                                data-key="MAX_CLIENTS"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Nivel IA</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="SERVER"
                                data-key="AI_LEVEL"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Pickup</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="PICKUP_MODE_ENABLED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Loop</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="LOOP_MODE"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Lobby</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="REGISTER_TO_LOBBY"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Contraseña</span>
                        <span class="config-value" id="servidor-pass">…</span>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Contraseña admin</span>
                        <span class="config-value" id="servidor-admin">…</span>
                    </div>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-coches">
                <div class="config-header">
                    <Icon name="car" size={20} />
                    <h2 id="cfg-coches">Coches</h2>
                </div>
                <div class="placeholder-card">
                    <h3>Próximamente</h3>
                    <p>
                        Valor actual: <code id="coches-valor">…</code>. Con
                        <code>*</code> los coches salen de otro archivo
                        (<code>entry_list.ini</code>), así que esta sección aún
                        no se edita aquí.
                    </p>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-sesiones">
                <div class="config-header">
                    <Icon name="gauge" size={20} />
                    <h2 id="cfg-sesiones">Sesiones</h2>
                </div>
                <div class="config-body">
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Práctica</span>
                            <input
                                class="field-input"
                                type="text"
                                data-section="PRACTICE"
                                data-key="NAME"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Minutos</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                data-section="PRACTICE"
                                data-key="TIME"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Práctica abierta</span>
                            <select
                                class="field-input"
                                data-section="PRACTICE"
                                data-key="IS_OPEN"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Práctica infinita</span>
                            <select
                                class="field-input"
                                data-section="PRACTICE"
                                data-key="INFINITE"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Carrera</span>
                            <input
                                class="field-input"
                                type="text"
                                data-section="RACE"
                                data-key="NAME"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Vueltas</span>
                            <input
                                class="field-input"
                                type="number"
                                min="1"
                                data-section="RACE"
                                data-key="LAPS"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Espera (s)</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="RACE"
                                data-key="WAIT_TIME"
                            />
                        </label>
                    </div>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-pista">
                <div class="config-header">
                    <Icon name="map" size={20} />
                    <h2 id="cfg-pista">Pista dinámica</h2>
                </div>
                <div class="config-body">
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Agarre inicial %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="SESSION_START"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Aleatoriedad %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="RANDOMNESS"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Transferencia %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="100"
                                data-section="DYNAMIC_TRACK"
                                data-key="SESSION_TRANSFER"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Grip por vuelta</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="DYNAMIC_TRACK"
                                data-key="LAP_GAIN"
                            />
                        </label>
                    </div>
                </div>
            </section>

            <section class="card config-card" aria-labelledby="cfg-reglas">
                <div class="config-header">
                    <Icon name="car" size={20} />
                    <h2 id="cfg-reglas">Reglas</h2>
                </div>
                <div class="config-body">
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">ABS</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="ABS_ALLOWED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">TC</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="TC_ALLOWED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Estabilidad</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="STABILITY_ALLOWED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Embrague auto.</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="AUTOCLUTCH_ALLOWED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Mantas</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="TYRE_BLANKETS_ALLOWED"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Espejo virtual</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="FORCE_VIRTUAL_MIRROR"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Combustible %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="SERVER"
                                data-key="FUEL_RATE"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Daños %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="SERVER"
                                data-key="DAMAGE_MULTIPLIER"
                            />
                        </label>
                        <label class="field">
                            <span class="field-label">Desgaste %</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                data-section="SERVER"
                                data-key="TYRE_WEAR_RATE"
                            />
                        </label>
                    </div>
                    <div class="field-row">
                        <label class="field">
                            <span class="field-label">Penalizaciones</span>
                            <select
                                class="field-input"
                                data-section="SERVER"
                                data-key="PENALTIES"
                                data-bool="1"
                            >
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                        </label>
                        <label class="field">
                            <span class="field-label">Salidas permitidas</span>
                            <input
                                class="field-input"
                                type="number"
                                min="0"
                                max="999"
                                data-section="SERVER"
                                data-key="ALLOWED_TYRES_OUT"
                            />
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <p class="alert" id="config-alert" role="alert" hidden></p>
    </form>
</BaseLayout>

<script src="../scripts/config.js"></script>
