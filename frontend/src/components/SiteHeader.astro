---
import Icon from "./Icon.astro";

// `current` marca el elemento de navegación activo
// ("inicio", "map", "cars", "config").
const { current } = Astro.props;

const links = [
    { id: "inicio", href: "/", label: "Inicio", icon: "home" },
    { id: "map", href: "/map", label: "Mapa", icon: "map" },
    { id: "cars", href: "/cars", label: "Coches", icon: "car" },
    { id: "config", href: "/config", label: "Configuración", icon: "gear" }
];

// Las tres páginas de ajustes comparten el botón Guardar de la cabecera.
// Cada página lo muestra y su script lo conecta a su propio formulario.
const withSave = ["map", "cars", "config"].includes(current);
---

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/" title="Assetto Server — Inicio">
            <Icon name="gauge" class="brand-icon" size={22} />
            <span>Assetto Server</span>
        </a>
        {withSave && (
            <button
                class="btn btn-primary btn-sm"
                id="save-top"
                type="button"
                hidden
            >
                Guardar
            </button>
        )}
        <nav class="nav" aria-label="Navegación principal">
            {links.map(link => (
                <a
                    class="nav-item"
                    href={link.href}
                    aria-current={current === link.id ? "page" : undefined}
                >
                    <Icon name={link.icon} size={16} />
                    <span>{link.label}</span>
                </a>
            ))}
        </nav>
    </div>
</header>
