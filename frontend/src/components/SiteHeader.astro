---
import Icon from "./Icon.astro";

// `current` marca el elemento de navegación activo ("inicio", "config", "menu").
const { current } = Astro.props;

const links = [
    { id: "inicio", href: "/", label: "Inicio", icon: "home" },
    { id: "config", href: "/config", label: "Configuración", icon: "gear" }
];

// Páginas que aún no existen: se muestran como elementos deshabilitados.
const disabled = [
    { label: "Mapa", icon: "map" },
    { label: "Coche", icon: "car" }
];
---

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/" title="Assetto Server — Inicio">
            <Icon name="gauge" class="brand-icon" size={22} />
            <span>Assetto Server</span>
        </a>
        <nav class="nav" aria-label="Navegación principal">
            {links.map(link => (
                <a
                    class="nav-item"
                    href={link.href}
                    aria-current={current === link.id ? "page" : undefined}
                >
                    <Icon name={link.icon} size={16} />
                    <span>{link.label}</span>
                </a>
            ))}
            {disabled.map(item => (
                <span
                    class="nav-item is-disabled"
                    title="Próximamente"
                    aria-disabled="true"
                >
                    <Icon name={item.icon} size={16} />
                    <span class="sr-only">{item.label}</span>
                </span>
            ))}
        </nav>
    </div>
</header>
